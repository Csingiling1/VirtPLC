# Backend API Configuration
VITE_API_BASE_URL=http://localhost:8080

# Instructions:
# 1. Make sure your backend API is running on the specified URL
# 2. The backend should provide the following endpoints:
#    - POST /auth/login - Authentication endpoint
#    - GET /api/data/latest - Get latest sensor data
#    - GET /api/data/range - Get historical data
#    - GET /api/simulator/* - Simulator endpoints
# 3. Update the URL above if your backend runs on a different port or host
