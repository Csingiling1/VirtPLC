# Backend API Configuration
# Leave empty to use Vite proxy (recommended for Docker development)
VITE_API_BASE_URL=

# Instructions:
# 1. When running in Docker with Vite dev server, leave VITE_API_BASE_URL empty
#    The Vite proxy will forward /api requests to http://backend:8080
# 2. For production builds, set this to the actual backend URL
# 3. The backend should provide the following endpoints:
#    - POST /auth/login - Authentication endpoint
#    - GET /api/data/latest - Get latest sensor data
#    - GET /api/data/range - Get historical data
#    - GET /api/simulator/* - Simulator endpoints
# 4. Update the URL above if your backend runs on a different port or host
