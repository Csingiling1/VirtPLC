# VirtPLC Production Environment Configuration
# Copy this file and customize for your deployment

# ==========================================
# SERVER IP CONFIGURATION
# ==========================================

# Historian Server (Server 3) - TimescaleDB + MCP
HISTORIAN_IP=192.168.1.30

# PLC-AI Server (Server 2) - Backend + AI + Frontend
PLC_AI_IP=192.168.1.20

# PLC Server (Server 1) - Simulator + HMI + Node-RED
PLC_IP=192.168.1.10

# ==========================================
# INDIVIDUAL SERVICE IPs (Optional - defaults provided)
# ==========================================

# Historian services
MCP_IP=192.168.1.31
CLEANUP_IP=192.168.1.32

# PLC-AI services
FRONTEND_IP=192.168.1.21
OLLAMA_IP=192.168.1.22
OLLAMA_INIT_IP=192.168.1.23
AI_IP=192.168.1.24
POSTGRES_IP=192.168.1.25
REDIS_IP=192.168.1.26
COLLECTOR_IP=192.168.1.27

# PLC services
SIMULATOR_MONITOR_IP=192.168.1.11
IGNITION_IP=192.168.1.12
MQTT_IP=192.168.1.13
NODERED_IP=192.168.1.14

# ==========================================
# PORT CONFIGURATION (Optional)
# ==========================================

# Historian ports
TIMESCALE_PORT=15433
MCP_PORT=9092

# PLC-AI ports
BACKEND_PORT=18080
MCP_BACKEND_PORT=8000
GRPC_PORT=9091
FRONTEND_PORT=3000
OLLAMA_PORT=11434
AI_PORT=3001
AI_WS_PORT=3002
AI_METRICS_PORT=9090
POSTGRES_PORT=15432
REDIS_PORT=6379
COLLECTOR_METRICS_PORT=9100

# PLC ports
SIMULATOR_PORT=5000
SIMULATOR_MONITOR_PORT=5002
IGNITION_PORT=8088
IGNITION_HTTPS_PORT=8043
IGNITION_MODBUS_PORT=8060
MQTT_PORT=1883
NODERED_PORT=1880

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

TIMESCALE_PASSWORD=changeme
POSTGRES_PASSWORD=changeme

# ==========================================
# AI CONFIGURATION
# ==========================================

# Claude API Key (required for Claude model support)
CLAUDE_API_KEY=your-claude-api-key-here

# ==========================================
# MQTT CONFIGURATION
# ==========================================

MQTT_USERNAME=virtplc
MQTT_PASSWORD=virtplc123

# ==========================================
# SECURITY CONFIGURATION
# ==========================================

JWT_SECRET=your-secret-key-change-in-production
NODE_RED_CREDENTIAL_SECRET=your-secret-key
IGNITION_USERNAME=admin
IGNITION_PASSWORD=password

# ==========================================
# ADDITIONAL CONFIGURATION
# ==========================================

# MQTT Configuration for cross-server communication
MQTT_BROKER_IP=${PLC_IP}
MQTT_BROKER_PORT=1883

# Backend configuration
BACKEND_API_URL=http://${PLC_AI_IP}:18080
SIMULATOR_API_URL=http://${PLC_IP}:8080
SIMULATOR_WS_URL=ws://${PLC_IP}:8080/ws/data

# AI Service configuration
OLLAMA_HOST=http://${OLLAMA_IP}:11434
MCP_SERVER_URL=http://${MCP_IP}:9092/sse