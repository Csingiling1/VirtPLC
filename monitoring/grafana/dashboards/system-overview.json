{
    "dashboard": {
        "id": null,
        "title": "VirtPLC System Overview",
        "tags": [
            "virtplc",
            "system"
        ],
        "timezone": "browser",
        "panels": [
            {
                "id": 1,
                "title": "CPU Usage by Service",
                "type": "graph",
                "targets": [
                    {
                        "expr": "rate(container_cpu_usage_seconds_total{namespace=\"virtplc\"}[5m]) * 100",
                        "legendFormat": "{{container_label_com_docker_compose_service}}"
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 0
                }
            },
            {
                "id": 2,
                "title": "Memory Usage by Service",
                "type": "graph",
                "targets": [
                    {
                        "expr": "container_memory_usage_bytes{namespace=\"virtplc\"}",
                        "legendFormat": "{{container_label_com_docker_compose_service}}"
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 0
                }
            },
            {
                "id": 3,
                "title": "Network I/O",
                "type": "graph",
                "targets": [
                    {
                        "expr": "rate(container_network_receive_bytes_total{namespace=\"virtplc\"}[5m])",
                        "legendFormat": "{{container_label_com_docker_compose_service}} RX"
                    },
                    {
                        "expr": "rate(container_network_transmit_bytes_total{namespace=\"virtplc\"}[5m])",
                        "legendFormat": "{{container_label_com_docker_compose_service}} TX"
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 24,
                    "x": 0,
                    "y": 8
                }
            }
        ],
        "time": {
            "from": "now-1h",
            "to": "now"
        },
        "timepicker": {},
        "templating": {
            "list": []
        },
        "annotations": {
            "list": []
        },
        "refresh": "5s",
        "schemaVersion": 27,
        "version": 0,
        "links": []
    }
}