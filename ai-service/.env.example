# Server Configuration
HOST=0.0.0.0
PORT=3001
WS_PORT=3002
ENVIRONMENT=development

# Backend API
BACKEND_API_URL=http://backend:8080
BACKEND_API_KEY=your-api-key

# Ollama Configuration
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:8b-instruct-q8_0
# Alternative models (uncomment to use):
# OLLAMA_MODEL=llama3.2:17b-instruct-q8_0   # Better accuracy, requires 24GB+ RAM
# OLLAMA_MODEL=llama3.2:8b-instruct-fp16     # Higher precision
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2048

# Claude Configuration
CLAUDE_API_KEY=your-claude-api-key

# MCP (Model Context Protocol) Configuration
MCP_ENABLED=true
MCP_SERVER_URL=http://mcp-server:8000
MCP_TIMEOUT=30

# TimeBase Configuration
TIMEBASE_URL=dts://timebase:8011
TIMEBASE_USER=admin
TIMEBASE_PASSWORD=changeme
TIMEBASE_STREAM=factory_metrics

# PostgreSQL (Relational Data)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=virtplc
POSTGRES_USER=virtplc
POSTGRES_PASSWORD=changeme

# Redis (Caching & Sessions)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Chat History Configuration
CHAT_HISTORY_RETENTION_DAYS=30
CHAT_HISTORY_MAX_MESSAGES=1000

# AI Analysis Configuration
ANALYSIS_INTERVAL=5000  # milliseconds
PREDICTION_THRESHOLD=0.7
ANOMALY_THRESHOLD=2.0  # standard deviations
MIN_DATA_POINTS=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
