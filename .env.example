# VirtPLC Environment Variables Template
# Copy this file to .env and configure for your environment

# =============================================================================
# DEPLOYMENT PROFILE
# =============================================================================
# Options: dev, stage2, prod
DEPLOYMENT_PROFILE=dev

# =============================================================================
# DEVELOPMENT PROFILE (Single Machine)
# =============================================================================
# No additional configuration needed for dev profile

# =============================================================================
# STAGE2 PROFILE (2 Computers: Computer1 + Computer2/PLC)
# =============================================================================
# Uncomment and configure if using stage2 profile

# Computer 2 (PLC) IP address
#PLC_HOST=192.168.1.100

# Computer 1 (Main Stack) IP address
#COMPUTER1_HOST=192.168.1.10

# =============================================================================
# PRODUCTION PROFILE (3 Servers)
# =============================================================================
# Uncomment and configure if using prod profile

# Server 1 - Windows PLC + Ignition + Node-RED
#SERVER1_HOST=192.168.1.10

# Server 2 - Linux Application Stack
#SERVER2_HOST=192.168.1.20

# Server 3 - Linux TimescaleDB
#SERVER3_HOST=192.168.1.30

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# TimescaleDB (Time-Series Data)
TIMESCALE_PASSWORD=changeme
TIMESCALE_DB=virtplc_ts
TIMESCALE_USER=virtplc

# PostgreSQL (Relational Data)
POSTGRES_PASSWORD=changeme
POSTGRES_DB=virtplc
POSTGRES_USER=virtplc

# =============================================================================
# SECURITY
# =============================================================================
# Generate with: openssl rand -base64 64
JWT_SECRET=your-secret-key-change-in-production

# Node-RED credentials
NODE_RED_CREDENTIAL_SECRET=your-secret-key
# Generate password hash with: docker exec plc-nodered node -e "console.log(require('bcryptjs').hashSync('your-password', 8))"
NODE_RED_PASSWORD_HASH=$2a$08$zZWtXTja0fB1pzD4sHCMyOCMYz2Z6dNbM6tl8sJogENOMcxWV9DN.
NODE_RED_USERNAME=admin

# Ignition Gateway (Production only)
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=password

# =============================================================================
# MQTT CONFIGURATION
# =============================================================================
# Used in Stage2 and Production on PLC/Node-RED machine
MQTT_BROKER=localhost
MQTT_PORT=1883

# =============================================================================
# OPC-UA CONFIGURATION
# =============================================================================
OPCUA_SERVER_PORT=4840
OPCUA_NAMESPACE=urn:virtplc:nodered

# =============================================================================
# AI SERVICE CONFIGURATION
# =============================================================================
# Ollama model selection
# Options: llama3:8b, qwen2:0.5b, mistral, etc.
OLLAMA_MODEL=qwen2:0.5b

# Analysis interval (milliseconds)
ANALYSIS_INTERVAL=5000

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Log levels: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Environment name for logging/monitoring
ENVIRONMENT=development

# =============================================================================
# PORTS CONFIGURATION (Advanced)
# =============================================================================
# Backend
BACKEND_PORT=18080
BACKEND_OPCUA_PORT=14840
BACKEND_MCP_PORT=8000
BACKEND_GRPC_PORT=9091

# Frontend
FRONTEND_PORT=3000

# AI Service
AI_SERVICE_PORT=3001
AI_SERVICE_WS_PORT=3002

# Databases
POSTGRES_EXTERNAL_PORT=15432
TIMESCALE_EXTERNAL_PORT=15433

# Ignition
IGNITION_HTTP_PORT=8088
IGNITION_HTTPS_PORT=8043

# Node-RED
NODERED_PORT=1880

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Compose project name
COMPOSE_PROJECT_NAME=virtplc

# Docker network
DOCKER_NETWORK=virtplc-network
