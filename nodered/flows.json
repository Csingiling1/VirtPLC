                "topic-extractor-temp"
            ]
        ]
    },
    {
        "id": "topic-extractor-temp",
        "type": "function",
        "z": "mqtt-to-opcua-flow",
        "name": "Extract Device ID Temp",
        "func": "const topicParts = msg.topic.split('/');\nconst deviceId = topicParts[1];\nconst sensorType = topicParts[2];\n\nmsg.deviceId = deviceId;\nmsg.sensorType = sensorType;\nmsg.value = parseFloat(msg.payload);\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 160,
        "wires": [
