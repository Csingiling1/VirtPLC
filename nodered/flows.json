                "json-parser-temp"
            ]
        ]
    },
    {
        "id": "json-parser-temp",
        "type": "json",
        "z": "mqtt-to-opcua-flow",
        "name": "JSON Parser Temp",
        "property": "payload",
        "action": "obj",
        "pretty": false,
        "x": 360,
        "y": 160,
