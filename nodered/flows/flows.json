    {
        "id": "validate_data",
        "type": "function",
        "z": "a1b2c3d4e5f6",
        "name": "Validate & Enrich",
        "func": "// Validate required fields\nif (!msg.payload.device_id || !msg.payload.timestamp) {\n    node.warn('Missing required fields');\n    return null;\n}\n\n// Increment message counter for statistics\nlet count = context.get('messageCount') || 0;\ncount++;\ncontext.set('messageCount', count);\n\n// Enrich with metadata\nmsg.enriched = {\n    ...msg.payload,\n    processed_at: new Date().toISOString(),\n    node_red_version: '1.0',\n    topic_original: msg.topic\n};\n\n// Add quality indicators\nmsg.enriched.data_quality = {\n    valid: true,\n    latency_ms: Date.now() - (msg.payload.timestamp * 1000)\n};\n\nnode.status({\n    fill: 'green',\n    shape: 'dot',\n    text: `Device: ${msg.payload.device_id} (Total: ${count})`\n});\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 140,
        "wires": [
            [
                "route_data",
                "log_enriched"
            ]
        ]
    },
