    {
        "id": "stats_counter",
        "type": "function",
        "z": "a1b2c3d4e5f6",
        "name": "Message Statistics",
        "func": "// Initialize counter in context\nlet count = context.get('messageCount') || 0;\nlet lastReset = context.get('lastReset') || Date.now();\n\n// Reset every hour\nif (Date.now() - lastReset > 3600000) {\n    count = 0;\n    lastReset = Date.now();\n    context.set('lastReset', lastReset);\n}\n\ncontext.set('messageCount', count);\n\nmsg.payload = {\n    total_messages: count,\n    uptime_seconds: (Date.now() - lastReset) / 1000,\n    messages_per_second: count / ((Date.now() - lastReset) / 1000)\n};\n\nnode.status({\n    fill: 'blue',\n    shape: 'ring',\n    text: `Total: ${count} msgs`\n});\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
