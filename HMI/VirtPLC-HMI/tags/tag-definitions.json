{
  "name": "Root",
  "tagType": "Folder",
  "tags": [
    {
      "name": "VirtPLC",
      "tagType": "Folder",
      "tags": [
        {
          "name": "Alarms",
          "tagType": "Folder",
          "tags": [
            {
              "valueSource": "expr",
              "dataType": "Boolean",
              "name": "Conveyor1_Overheat",
              "tagType": "AtomicTag",
              "expression": "{[.]../FactoryTags/Conveyor1/Temperature} > 80",
              "documentation": "Active if Conv 1 Temp > 80C",
              "alarmConfig": {
                "High Temp": {
                  "priority": "High",
                  "enabled": true,
                  "name": "High Temp"
                }
              }
            },
            {
              "valueSource": "expr",
              "dataType": "Boolean",
              "name": "Conveyor2_Overheat",
              "tagType": "AtomicTag",
              "expression": "{[.]../FactoryTags/Conveyor2/Temperature} > 80",
              "documentation": "Active if Conv 2 Temp > 80C"
            },
            {
              "valueSource": "expr",
              "dataType": "Boolean",
              "name": "Machine1_Overheat",
              "tagType": "AtomicTag",
              "expression": "{[.]../FactoryTags/Machine1/Temperature} > 85",
              "documentation": "Active if Machine 1 Temp > 85C"
            },
            {
              "valueSource": "expr",
              "dataType": "Boolean",
              "name": "System_Fault",
              "tagType": "AtomicTag",
              "expression": "{[.]Conveyor1_Overheat} || {[.]Conveyor2_Overheat} || {[.]Machine1_Overheat}",
              "documentation": "General System Fault"
            }
          ]
        },
        {
          "name": "FactoryTags",
          "tagType": "Folder",
          "tags": [
            {
              "name": "Conveyor1",
              "tagType": "Folder",
              "tags": [
                {
                  "valueSource": "memory",
                  "dataType": "Float4",
                  "name": "RPM",
                  "value": 45.5,
                  "tagType": "AtomicTag"
                },
                {
                  "valueSource": "memory",
                  "dataType": "Float4",
                  "name": "Temperature",
                  "value": 65.2,
                  "tagType": "AtomicTag"
                },
                {
                  "valueSource": "memory",
                  "dataType": "Boolean",
                  "name": "Running",
                  "value": true,
                  "tagType": "AtomicTag"
                }
              ]
            },
            {
              "name": "Conveyor2",
              "tagType": "Folder",
              "tags": [
                {
                  "valueSource": "memory",
                  "dataType": "Float4",
                  "name": "RPM",
                  "value": 42.1,
                  "tagType": "AtomicTag"
                },
                {
                  "valueSource": "memory",
                  "dataType": "Float4",
                  "name": "Temperature",
                  "value": 58.4,
                  "tagType": "AtomicTag"
                },
                {
                  "valueSource": "memory",
                  "dataType": "Boolean",
                  "name": "Running",
                  "value": true,
                  "tagType": "AtomicTag"
                }
              ]
            },
            {
              "name": "Machine1",
              "tagType": "Folder",
              "tags": [
                {
                  "valueSource": "memory",
                  "dataType": "Float4",
                  "name": "X",
                  "value": 120.5,
                  "tagType": "AtomicTag"
                },
                {
                  "valueSource": "memory",
                  "dataType": "Float4",
                  "name": "Y",
                  "value": 45.2,
                  "tagType": "AtomicTag"
                },
                {
                  "valueSource": "memory",
                  "dataType": "Float4",
                  "name": "Temperature",
                  "value": 72.1,
                  "tagType": "AtomicTag"
                },
                {
                  "valueSource": "memory",
                  "dataType": "Boolean",
                  "name": "Running",
                  "value": true,
                  "tagType": "AtomicTag"
                },
                {
                    "valueSource": "memory",
                    "dataType": "Boolean",
                    "name": "IsReady",
                    "value": true,
                    "tagType": "AtomicTag"
                  }
              ]
            }
          ]
        },
        {
          "name": "System",
          "tagType": "Folder",
          "tags": [
            {
              "valueSource": "expr",
              "dataType": "String",
              "name": "Overall_Status",
              "tagType": "AtomicTag",
              "expression": "if({[.]../Alarms/System_Fault}, 'FAULT', if({[.]../FactoryTags/Conveyor1/Running]} && {[.]../FactoryTags/Conveyor2/Running]}, 'RUNNING', 'IDLE'))"
            },
            {
              "valueSource": "expr",
              "dataType": "Float4",
              "name": "Total_Power",
              "tagType": "AtomicTag",
              "expression": "{[.]../FactoryTags/Conveyor1/RPM} * 0.5 + {[.]../FactoryTags/Conveyor2/RPM} * 0.5 + 10"
            },
            {
              "valueSource": "expr",
              "dataType": "Float4",
              "name": "Efficiency",
              "tagType": "AtomicTag",
              "expression": "if({[.]Total_Power} > 0, ({[.]../FactoryTags/Conveyor1/RPM} + {[.]../FactoryTags/Conveyor2/RPM}) / {[.]Total_Power} * 10, 0)"
            },
            {
              "valueSource": "expr",
              "dataType": "DateTime",
              "name": "Last_Update",
              "tagType": "AtomicTag",
              "expression": "now()"
            }
          ]
        }
      ]
    }
  ]
}