{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 1000,
      "width": 1670
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Motor1Card"
        },
        "position": {
          "height": 450,
          "width": 800,
          "x": 20,
          "y": 20
        },
        "props": {
          "style": {
            "backgroundColor": "#ffffff",
            "borderRadius": "8px",
            "boxShadow": "0 2px 8px rgba(0,0,0,0.1)"
          }
        },
        "type": "ia.container.coord",
        "children": [
          {
            "meta": {
              "name": "Motor1Title"
            },
            "position": {
              "height": 40,
              "width": 760,
              "x": 20,
              "y": 10
            },
            "props": {
              "text": "Motor 1",
              "style": {
                "fontSize": "24px",
                "fontWeight": "bold",
                "color": "#1e3a5f"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Motor1Speed"
            },
            "position": {
              "height": 60,
              "width": 350,
              "x": 20,
              "y": 60
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "tagPath": "[default]Motor1/Speed"
                  }
                }
              }
            },
            "props": {
              "label": "Speed (RPM)",
              "value": 0,
              "min": 0,
              "max": 2500,
              "style": {
                "fontSize": "18px"
              }
            },
            "type": "ia.display.gauge"
          },
          {
            "meta": {
              "name": "Motor1Temp"
            },
            "position": {
              "height": 60,
              "width": 350,
              "x": 400,
              "y": 60
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "tagPath": "[default]Motor1/Temp"
                  }
                }
              }
            },
            "props": {
              "label": "Temperature (°C)",
              "value": 0,
              "min": 0,
              "max": 100,
              "style": {
                "fontSize": "18px"
              }
            },
            "type": "ia.display.gauge"
          },
          {
            "meta": {
              "name": "Motor1RunStatus"
            },
            "position": {
              "height": 50,
              "width": 350,
              "x": 20,
              "y": 140
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "tagPath": "[default]Motor1/Run"
                  },
                  "transforms": [
                    {
                      "type": "script",
                      "config": {
                        "script": "return 'RUNNING' if value else 'STOPPED'"
                      }
                    }
                  ]
                }
              },
              "props.style.backgroundColor": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "tagPath": "[default]Motor1/Run"
                  },
                  "transforms": [
                    {
                      "type": "script",
                      "config": {
                        "script": "return '#28a745' if value else '#dc3545'"
                      }
                    }
                  ]
                }
              }
            },
            "props": {
              "text": "STOPPED",
              "style": {
                "fontSize": "20px",
                "fontWeight": "bold",
                "color": "#ffffff",
                "textAlign": "center",
                "padding": "10px",
                "borderRadius": "4px"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Motor1FaultStatus"
            },
            "position": {
              "height": 50,
              "width": 350,
              "x": 400,
              "y": 140
            },
            "propConfig": {
              "props.visible": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "tagPath": "[default]Motor1/Fault"
                  }
                }
              }
            },
            "props": {
              "text": "⚠ FAULT DETECTED",
              "visible": false,
              "style": {
                "fontSize": "18px",
                "fontWeight": "bold",
                "color": "#ffffff",
                "backgroundColor": "#ffc107",
                "textAlign": "center",
                "padding": "10px",
                "borderRadius": "4px"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Motor1TargetSpeed"
            },
            "position": {
              "height": 80,
              "width": 350,
              "x": 20,
              "y": 210
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "tagPath": "[default]Motor1/TargetSpeed",
                    "bidirectional": true
                  }
                }
              }
            },
            "props": {
              "label": "Target Speed (RPM)",
              "value": 1500,
              "min": 0,
              "max": 2200,
              "step": 50
            },
            "type": "ia.input.numeric"
          },
          {
            "meta": {
              "name": "Motor1StartButton"
            },
            "position": {
              "height": 60,
              "width": 160,
              "x": 20,
              "y": 310
            },
            "props": {
              "text": "START",
              "style": {
                "backgroundColor": "#28a745",
                "color": "#ffffff",
                "fontSize": "18px",
                "fontWeight": "bold"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "script": "system.tag.writeBlocking(['[default]Motor1/Run'], [True])"
                }
              }
            },
            "type": "ia.input.button"
          },
          {
            "meta": {
              "name": "Motor1StopButton"
            },
            "position": {
              "height": 60,
              "width": 160,
              "x": 200,
              "y": 310
            },
            "props": {
              "text": "STOP",
              "style": {
                "backgroundColor": "#dc3545",
                "color": "#ffffff",
                "fontSize": "18px",
                "fontWeight": "bold"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "script": "system.tag.writeBlocking(['[default]Motor1/Run'], [False])"
                }
              }
            },
            "type": "ia.input.button"
          },
          {
            "meta": {
              "name": "Motor1ResetButton"
            },
            "position": {
              "height": 60,
              "width": 160,
              "x": 380,
              "y": 310
            },
            "props": {
              "text": "RESET FAULT",
              "style": {
                "backgroundColor": "#ffc107",
                "color": "#000000",
                "fontSize": "16px",
                "fontWeight": "bold"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "script": "system.tag.writeBlocking(['[default]Motor1/Fault', '[default]Motor1/Run'], [False, False])"
                }
              }
            },
            "type": "ia.input.button"
          }
        ]
      },
