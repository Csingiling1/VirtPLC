<?xml version="1.0" encoding="UTF-8"?>
<gateway>
  <config version="8.1.28">
    <name>VirtPLC-Gateway</name>
    <description>Standalone HMI Gateway for Testing</description>

    <!-- System Settings -->
    <system>
      <httpPort>8088</httpPort>
      <httpsPort>8043</httpsPort>
      <timezone>UTC</timezone>
      <locale>en-US</locale>
      <logLevel>INFO</logLevel>
    </system>

    <!-- Tag Provider Settings -->
    <tagProviders>
      <provider>
        <name>default</name>
        <enabled>true</enabled>
        <type>standard</type>

        <!-- Tag History (disabled for standalone) -->
        <historyProvider>
          <enabled>false</enabled>
        </historyProvider>

        <!-- Tag Alarms (disabled for standalone) -->
        <alarmProvider>
          <enabled>false</enabled>
        </alarmProvider>
      </provider>
    <!-- Database Connections -->
    <databases>
      <database>
        <name>TimescaleDB</name>
        <enabled>true</enabled>
        <driver>PostgreSQL</driver>
        <connectUrl>jdbc:postgresql://timescale:5432/virtplc</connectUrl>
        <username>virtplc</username>
        <password>virtplc123</password>
        <validationQuery>SELECT 1</validationQuery>
      </database>
    </databases>
