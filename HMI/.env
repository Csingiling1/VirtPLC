# VirtPLC HMI Environment Variables
# Copy this file to .env and configure for your environment

# Gateway Configuration
GATEWAY_PASSWORD=admin123
GATEWAY_EDITION=edge

# Database Configuration
POSTGRES_PASSWORD=virtplc_secure_pass
POSTGRES_DB=virtplc
POSTGRES_USER=virtplc

# Redis Configuration
REDIS_PASSWORD=

# Monitoring
GRAFANA_PASSWORD=admin

# Network Configuration
GATEWAY_HTTP_PORT=8088
GATEWAY_HTTPS_PORT=8043
GATEWAY_NETWORK_PORT=8060
TIMEBASE_PORT=8011
POSTGRES_PORT=5432
REDIS_PORT=6379
GRAFANA_PORT=3000
PROMETHEUS_PORT=9091

# OPC-UA Configuration
OPCUA_ENDPOINT=opc.tcp://backend:4840

# TimeBase Configuration
TIMEBASE_RETENTION_DAYS=30

# Logging
LOG_LEVEL=INFO

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=7

# SSL/TLS (set to true for production)
SSL_ENABLED=false
SSL_CERT_PATH=/certs/server.crt
SSL_KEY_PATH=/certs/server.key
