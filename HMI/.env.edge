# Edge Device Environment Variables
# Copy to .env and modify as needed

# IMPORTANT: Set this to your backend server IP address
BACKEND_SERVER_IP=192.168.1.100

# Ignition Gateway Configuration
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=password123!
GATEWAY_USESSL=false

# PostgreSQL (Backend) Connection
POSTGRES_DB=virtplc
POSTGRES_USER=virtplc
POSTGRES_PASSWORD=changeme123!

# PLC Simulator Configuration
LOG_LEVEL=INFO
SIMULATION_SPEED=1.0
ENABLE_FAULTS=true
FAULT_PROBABILITY=0.01
