# Crontab for TimescaleDB cleanup
# Run every 2 months (on the 1st day at 2 AM)

# Environment variables for the cleanup script
TIMESCALE_HOST=timescale
TIMESCALE_PORT=5432
TIMESCALE_DB=virtplc_ts
TIMESCALE_USER=virtplc
TIMESCALE_PASSWORD=changeme
MAILTO=""

# Cleanup job - runs at 2 AM on the 1st of every 2nd month (Jan, Mar, May, Jul, Sep, Nov)
0 2 1 1,3,5,7,9,11 * /app/scripts/timescale_cleanup.sh >> /var/log/timescale_cleanup.log 2>&1
